{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Basic information about the application user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "userRole": { "type": "string", "enum": ["owner", "accountant"] },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Client": {
      "title": "Client/Business Profile",
      "description": "Accounting data for a specific business.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "tin": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "ownerId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles."
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients belonging to a specific user."
    }
  }
}
